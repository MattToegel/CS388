<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >

    <TextView
        android:id="@+id/lobbyTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Create or Search a Lobby"
        android:textSize="20sp"
        android:layout_marginBottom="16dp"
        android:textAlignment="center"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/lobbyNameEditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Lobby Name"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/lobbyTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/maxPlayersEditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:hint="Max Players"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/lobbyNameEditText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/createLobbyButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Create Lobby"
        app:layout_constraintTop_toBottomOf="@id/maxPlayersEditText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/searchLobbyButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Search Lobby"
        app:layout_constraintTop_toBottomOf="@id/createLobbyButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/lobbySearchResults"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Search Results"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/searchLobbyButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
