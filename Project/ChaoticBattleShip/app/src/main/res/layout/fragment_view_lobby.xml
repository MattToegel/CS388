<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView
        android:id="@+id/lobbyNameTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Lobby Name: Placeholder"
        android:textSize="18sp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/lobbyPlayersTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Players: 1/4"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/lobbyNameTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/lobbyStatusTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Status: Open"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/lobbyPlayersTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/leaveLobbyButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Leave Lobby"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/lobbyStatusTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
