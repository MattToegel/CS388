<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Lobby Name -->
    <TextView
        android:id="@+id/lobbyName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Lobby Name"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp" />

    <!-- Current Players -->
    <TextView
        android:id="@+id/currentPlayers"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Players: 0"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/lobbyName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="8dp" />

    <!-- Max Players -->
    <TextView
        android:id="@+id/maxPlayers"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Max Players: 0"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/currentPlayers"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp" />

    <!-- Leave Lobby Button -->
    <Button
        android:id="@+id/leaveLobbyButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Leave Lobby"
        app:layout_constraintTop_toBottomOf="@id/maxPlayers"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
